    "directory": "packages/pm2md-core"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/pm2md/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
