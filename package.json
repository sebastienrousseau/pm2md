{
  "name": "@sebastienrousseau/pm2md-workspace",
  "private": true,
  "version": "0.0.4",
  "description": "Generates a markdown documentation from a Postman collection file.",
  "homepage": "https://pm2md.com",
  "keywords": [
    "pm2md",
    "postman",
    "markdown",
    "api-documentation"
  ],
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/pm2md.git"
  },
  "bin": "./dist/bin/pm2md.js",
  "bugs": {
    "url": "https://github.com/sebastienrousseau/pm2md/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/sebastienrousseau"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/wwdseb"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "git-checks": false,
  "preferGlobal": true,
  "scripts": {
    "build:pm2md": "pnpm -r --workspace-concurrency=1 run build",
    "build": "pnpm run build:pm2md",
    "build:watch": "tsc -w",
    "clean": "pnpm -r run clean && rimraf dist coverage node_modules",
    "docs": "typedoc --options typedoc.json ./packages/*/src/**/*.ts",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "lint": "eslint \"./packages/*/src/**/*.ts\" \"./packages/*/__tests__/**/*.ts\"",
    "lint:fix": "eslint --fix \"./packages/*/src/**/*.ts\" \"./packages/*/__tests__/**/*.ts\"",
    "markdown": "remark ./*.md ./**/*.md --rc-path ./.remarkrc --quiet",
    "test": "jest --coverage --config jest.config.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@sebastienrousseau/eslint-config": "^0.0.2",
    "@sebastienrousseau/jsdoc-config": "^0.0.5",
    "@sebastienrousseau/markdownlint-config": "^0.0.1",
    "@sebastienrousseau/prettier-config": "^0.0.4",
    "@sebastienrousseau/remark-config": "^0.0.3",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint": "^8.51.0",
    "filesizes": "^0.1.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "remark-cli": "^12.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-preset-lint-consistent": "^5.1.2",
    "remark-preset-lint-markdown-style-guide": "^5.1.3",
    "remark-preset-lint-recommended": "^6.1.3",
    "rimraf": "^5.0.5",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "typedoc-plugin-missing-exports": "^2.1.0",
    "typedoc": "^0.25.1",
    "typescript": "^5.2.2"
  },
  "directories": {
    "src": "src",
    "test": "__tests__"
  },
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "commonjs",
  "lockfileVersion": 1,
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "autoupdate": {
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      }
    ],
    "source": "git",
    "target": "git://github.com/sebastienrousseau/pm2md.git"
  }
}
